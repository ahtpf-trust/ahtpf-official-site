# =========================================================================
# NEXT.JS ENVIRONMENT VARIABLES FOR SUPABASE CONNECTIVITY
# Copy this file to .env.local and fill in the values from your Supabase Dashboard.
# =========================================================================

# Public Variables (Accessed by both Client & Server)
# Retrieve these from: Supabase Settings -> API -> Project API Keys -> anon (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret Variables (Accessed ONLY on Server)
# Retrieve this from: Supabase Settings -> API -> Project API Keys -> service_role (secret)
# DANGER: NEVER commit this key to Git or share it publicly!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Admin Portal Mock Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

